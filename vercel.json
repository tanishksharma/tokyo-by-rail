{
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/stations",
      "destination": "/"
    },
    {
      "source": "/quiz",
      "destination": "/"
    },
    {
      "source": "/about",
      "destination": "/"
    }
  ],
  "redirects": [
    {
      "source": "/learn",
      "destination": "/stations",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build-app.mjs offline-remote.json",
  "outputDirectory": "dist"
}
